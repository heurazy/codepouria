+    private static boolean isBuriedOpaqueCube(ClientLevel level, BlockPos pos, BlockState state) {
+        if (!state.isSolidRender()) return false;
+        return level.getBlockState(pos.offset(1, 0, 0)).isSolidRender()
+            && level.getBlockState(pos.offset(-1, 0, 0)).isSolidRender()
+            && level.getBlockState(pos.offset(0, 1, 0)).isSolidRender()
+            && level.getBlockState(pos.offset(0, -1, 0)).isSolidRender()
+            && level.getBlockState(pos.offset(0, 0, 1)).isSolidRender()
+            && level.getBlockState(pos.offset(0, 0, -1)).isSolidRender();
