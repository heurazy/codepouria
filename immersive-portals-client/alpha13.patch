+    private static void drawPortalDepthSeal(
+        PoseStack.Pose pose,
+        VertexConsumer buffer,
+        PortalFrame frame,
+        Vec3 camera
+    ) {
+        double sign = sourceBehindSign(frame, camera);
+        float minX = frame.minX() + (float) INSET;
+        float maxX = frame.maxX() + 1.0f - (float) INSET;
+        float minY = frame.minY() + (float) INSET;
+        float maxY = frame.maxY() + 1.0f - (float) INSET;
+        float minZ = frame.minZ() + (float) INSET;
+        float maxZ = frame.maxZ() + 1.0f - (float) INSET;
+
+        switch (frame.plane()) {
+            case X -> {
+                float z = (float) (frame.center().z + sign * DEPTH_SEAL_OFFSET);
+                buffer.addVertex(pose, minX, minY, z);
+                buffer.addVertex(pose, maxX, minY, z);
+                buffer.addVertex(pose, maxX, maxY, z);
+                buffer.addVertex(pose, minX, maxY, z);
+            }
+            case Z -> {
+                float x = (float) (frame.center().x + sign * DEPTH_SEAL_OFFSET);
+                buffer.addVertex(pose, x, minY, minZ);
+                buffer.addVertex(pose, x, maxY, minZ);
+                buffer.addVertex(pose, x, maxY, maxZ);
+                buffer.addVertex(pose, x, minY, maxZ);
+            }
+            case HORIZONTAL -> {
+                float y = (float) (frame.center().y + sign * DEPTH_SEAL_OFFSET);
+                buffer.addVertex(pose, minX, y, minZ);
+                buffer.addVertex(pose, minX, y, maxZ);
+                buffer.addVertex(pose, maxX, y, maxZ);
+                buffer.addVertex(pose, maxX, y, minZ);
+            }
+        }
+    }
